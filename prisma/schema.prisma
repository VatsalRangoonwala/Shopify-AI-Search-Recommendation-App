generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String   @id
  shop                String
  state               String
  isOnline            Boolean  @default(false)
  scope               String?
  expires             DateTime @default(now())
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean  @default(false)
  locale              String?
  collaborator        Boolean? @default(false)
  emailVerified       Boolean? @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime @default(now())
}

model Store {
  id          String   @id @default(cuid())
  shop        String   @unique
  accessToken String
  isOnboarding  Boolean @default(true)
  diversity   Float    @default(0.0)
  createdAt   DateTime @default(now())

  products Product[]
  sorting  Sorting[]
  events   Event[]
  syncJobs SyncJob[]
  filters  Filter[]
  filterValues    FilterValue[]
}

model Product {
  id                 String    @id @default(cuid())
  storeId            String

  shopifyGraphqlId   String
  shopifyProductId   String

  handle             String?
  title              String
  description        String?
  bodyHtml           String?
  vendor             String?
  productType        String?
  status             String?

  tags               String[]
  
  minPrice           Float?
  maxPrice           Float?
  compareAtMinPrice  Float?
  compareAtMaxPrice  Float?

  availableForSale   Boolean?
  totalInventory     Int?

  featuredImage      String?
  images             Json?

  options            Json?
  variants           Json?

  attributes         Json?
  metafields         Json?

  publishedAt        DateTime?
  createdAtShopify   DateTime?
  updatedAtShopify   DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyProductId])
  @@index([storeId])
  @@index([storeId, vendor])
  @@index([storeId, productType])
}

model Filter {
  id            String   @id @default(cuid())
  storeId       String

  key           String   
  label         String   

  source        String   // system, option, tag, metafield
  sourceField   String?  // vendor, productType, tags, metafields

  values        String[] // all unique values
  productCount  Int?     // how many products contain this filter
  uniqueCount   Int?     // how many unique values

  valueType     String?  // string, number, range
  uiType        String?  // checkbox, dropdown, swatch, slider

  status        String   @default("detected") // detected, selected, disabled
  position      Int      @default(0)
  isVisible     Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@index([storeId])
  @@index([storeId, status])
}

model Sorting {
  id       String  @id @default(cuid())
  storeId  String
  name     String
  label    String
  field    String
  order    String
  position Int
  isActive Boolean @default(true)

  store Store @relation(fields: [storeId], references: [id])
}

model Event {
  id         String   @id @default(cuid())
  storeId    String
  sessionId  String?
  customerId String?
  type       String
  productId  String
  timestamp  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
}

model SyncJob {
  id            String   @id @default(cuid())
  storeId       String
  status        String // pending | running | completed
  totalProducts Int      @default(0)
  processed     Int      @default(0)
  createdAt     DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
}
