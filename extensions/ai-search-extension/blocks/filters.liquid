<div class="ai-filters">
  <h3>{{ block.settings.title }}</h3>

  <div id="ai-filters-root"></div>
</div>

<style>
  .ai-filters {
    padding: 16px;
    border: 1px solid #eee;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .ai-filters h3 {
    font-size: 18px;
    margin-bottom: 10px;
  }

  .ai-filter-group {
    margin-bottom: 15px;
  }

  .ai-filter-group label {
    display: block;
    margin-bottom: 5px;
    cursor: pointer;
  }
</style>

<script>
  
  document.addEventListener('DOMContentLoaded', async () => {
    const shop = '{{ shop.domain }}';

    const res = await fetch(`/apps/api/filters?shop=${shop}`, {
      headers: {
        'ngrok-skip-browser-warning': 'true',
      },
    });
    const filters = await res.json();

    const container = document.getElementById('ai-filters-root');

    filters.forEach((filter) => {
      const group = document.createElement('div');
      group.className = 'ai-filter-group';

      let html = `<strong>${filter.name}</strong>`;

      filter.values.forEach((val) => {
        html += `
        <label>
          <input type="checkbox"
                 data-filter="${filter.name}"
                 value="${val}" />
          ${val}
        </label>
      `;
      });

      group.innerHTML = html;
      container.appendChild(group);
    });
  });
</script>

{% schema %}
{
  "name": "AI Filters",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Filters"
    }
  ]
}
{% endschema %}
