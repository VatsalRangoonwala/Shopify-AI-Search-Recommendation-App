<div style="width: 200px; height: 100px; background-color: lightblue;" id="ai-filters-root"></div>

<script>
  const shop = '{{ shop.domain }}';

  async function loadFilters() {
    const res = await fetch(`/apps/api/filters?shop=${shop}`, {
      headers: {
        'ngrok-skip-browser-warning': 'true',
      },
    });
    const filters = await res.json();

    const container = document.getElementById('ai-filters-root');

    filters.forEach((filter) => {
      const div = document.createElement('div');

      div.innerHTML = `
        <h4>${filter.name}</h4>
        ${filter.values
          .map(
            (val) => `
          <label>
            <input type="checkbox" value="${val}" data-filter="${filter.name}" />
            ${val}
          </label>
        `
          )
          .join('')}
      `;

      container.appendChild(div);
    });
  }

  loadFilters();
</script>

{% schema %}
{
  "name": "Filters",
  "target": "section",
  "settings": []
}
{% endschema %}
