          badge: 'Sale',
          image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&q=80',
        },
      ];

      const grid = document.getElementById('ai-products-grid');
      grid.innerHTML = '';

      // Loop through dummy data (swap dummyProducts for products later)
      products.forEach((p) => {
        const card = document.createElement('div');
        card.className = 'ecom-card';
        card.innerHTML = createProductCardHTML(p);

        // Event Listeners
        card.addEventListener('click', () => trackEvent('view', p.id));
        card.querySelector('.add-btn').addEventListener('click', (e) => {
          e.stopPropagation();
          trackEvent('add_to_cart', p.id);
        });
        card.querySelector('.rec-btn').addEventListener('click', (e) => {
          e.stopPropagation();
          trackEvent('recommendation_click', p.id);
        });

        grid.appendChild(card);
      });
    } catch (err) {
      console.error('Product fetch failed:', err);
    }
  }

  async function loadRecommendations(shop) {
    const sessionId = getOrCreateSessionId();
    try {
      // THE ACTUAL API CALL REMAINS INTACT
      const res = await fetch('/apps/api/recommendations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ shop, sessionId }),
      });
      const products = await res.json(); // <-- Uncomment this when API returns full data

      // --- HARDCODED DUMMY REC DATA ---
      const dummyRecommendations = [
        {
          id: '7',
          title: 'Wireless Charging Pad',
          vendor: 'TechGear',
          price: '₹1,299',
          compareAtPrice: '₹1,999',
          rating: 4.6,
          reviews: 42,
          badge: 'Recommended',
          image: 'https://images.unsplash.com/photo-1586816879360-004f5b0c51e3?w=500&q=80',
        },
        {
          id: '8',
          title: 'Aromatherapy Essential Oil Diffuser',
          vendor: 'ZenHome',
          price: '₹1,899',
          compareAtPrice: null,
          rating: 4.4,
          reviews: 112,
          badge: null,
          image: 'https://images.unsplash.com/photo-1608528577891-eb055944f2e7?w=500&q=80',
        },
        {
          id: '9',
          title: 'Polarized Sunglasses',
          vendor: 'SunShade',
          price: '₹2,199',
          compareAtPrice: '₹3,499',
          rating: 4.8,
          reviews: 67,
          badge: 'Sale',
          image: 'https://images.unsplash.com/photo-1511499767150-a48a237f0083?w=500&q=80',
        },
        {
          id: '10',
          title: 'Stainless Steel Water Bottle',
          vendor: 'HydroLife',
          price: '₹899',
          compareAtPrice: null,
          rating: 4.3,
          reviews: 205,
          badge: null,
          image: 'https://images.unsplash.com/photo-1602143407151-7111542de6e8?w=500&q=80',
        },
      ];

      const container = document.getElementById('ai-recommendations-grid');
      container.innerHTML = '';

      // Loop through dummy data
      products.forEach((p) => {
        const card = document.createElement('div');
        card.className = 'ecom-card';
        card.innerHTML = createProductCardHTML(p);

        card.addEventListener('click', () => trackEvent('recommendation_click', p.id));
        card.querySelector('.add-btn').addEventListener('click', (e) => {
          e.stopPropagation();
          trackEvent('add_to_cart', p.id);
        });

        container.appendChild(card);
      });
    } catch (err) {
      console.error('Recommendations fetch failed:', err);
    }
  }

  // --- Initialization & Event Listeners ---
  document.addEventListener('DOMContentLoaded', async () => {
    const shop = '{{ shop.domain }}';
    await loadFiltersAndSorting(shop);
    fetchProducts();
    loadRecommendations(shop);
  });

  // Re-fetch products when filters, sorting, or search changes
  document.addEventListener('change', (e) => {
    if (
      e.target.matches('input[type="checkbox"]') ||
      e.target.id === 'ai-sorting-select' ||
      e.target.id === 'search-input'
    ) {
      fetchProducts();
    }
  });
</script>

{% schema %}
{
  "name": "AI Discovery Engine",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Filters Settings"
    },
    {
      "type": "text",
      "id": "filter_title",
      "label": "Filters Heading",
      "default": "Filters"
    },
    {
      "type": "header",
      "content": "Sorting Settings"
    },
    {
      "type": "text",
      "id": "sorting_label",
      "label": "Sorting Label",
      "default": "Sort By"
    },
    {
      "type": "header",
      "content": "Product Grid Settings"
    },
    {
      "type": "text",
      "id": "products_title",
      "label": "Products Heading",
      "default": "All Products"
    },
    {
      "type": "header",
      "content": "Recommendations Settings"
    },
    {
      "type": "text",
      "id": "recommendations_title",
      "label": "Recommendations Heading",
      "default": "Recommended for you"
    }
  ]
}
{% endschema %}
