<div id="ai-products"></div>

<script>
  const shop = "{{ shop.domain }}";

  async function searchProducts() {
    const selectedFilters = {};

    document.querySelectorAll("input[type=checkbox]:checked")
      .forEach(input => {
        const key = input.dataset.filter;

        if (!selectedFilters[key]) {
          selectedFilters[key] = [];
        }

        selectedFilters[key].push(input.value);
      });

    const sort = document.getElementById("ai-sorting")?.value;

    const res = await fetch(`/apps/api/search`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        shop,
        filters: selectedFilters,
        sort,
      }),
    });

    const products = await res.json();

    const container = document.getElementById("ai-products");
    container.innerHTML = "";

    products.forEach(p => {
      const div = document.createElement("div");

      div.innerHTML = `
        <h3>${p.title}</h3>
        <p>₹ ${p.price}</p>
      `;

      container.appendChild(div);
    });
  }

  // Trigger search on change
  document.addEventListener("change", searchProducts);
</script>

{% schema %}
{
  "name": "Search",
  "target": "section",
  "settings": []
}
{% endschema %}