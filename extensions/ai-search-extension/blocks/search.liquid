<div class="ai-products">
  <h3>{{ block.settings.title }}</h3>
  <input id="search-input" placeholder="Search products...">

  <div id="ai-products-grid" class="grid"></div>
</div>

<style>
  .ai-products .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .ai-product-card {
    border: 1px solid #eee;
    padding: 10px;
    border-radius: 6px;
  }

  .ai-product-card h4 {
    font-size: 16px;
  }
</style>

<script>
  function getOrCreateSessionId() {
    let sessionId = localStorage.getItem('ai_session_id');

    if (!sessionId) {
      sessionId = crypto.randomUUID();
      localStorage.setItem('ai_session_id', sessionId);
    }

    return sessionId;
  }
  async function trackEvent(type, productId) {
    try {
      const sessionId = getOrCreateSessionId();

      await fetch('/apps/api/events', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          type,
          productId,
          sessionId,
          shop: Shopify.shop,
        }),
      });
    } catch (err) {
      console.error('Tracking failed', err);
    }
  }
  async function fetchProducts() {
    const shop = '{{ shop.domain }}';
    const query = document.getElementById('search-input')?.value || '';

    // 🔥 TRACK SEARCH EVENT
    if (query && query.trim().length > 0) {
      trackEvent('search', query);
    }

    const filters = {};
    document.querySelectorAll('input[type=checkbox]:checked').forEach((input) => {
      const key = input.dataset.filter;
      if (!filters[key]) filters[key] = [];
      filters[key].push(input.value);
    });

    const sort = document.getElementById('ai-sorting-select')?.value;

    const res = await fetch(`/apps/api/search`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'ngrok-skip-browser-warning': 'true',
      },
      body: JSON.stringify({ shop, filters, sort, query }),
    }).catch((err) => console.log('err:', err));

    const products = await res.json();

    const grid = document.getElementById('ai-products-grid');
    grid.innerHTML = '';

    products.forEach((p) => {
      const card = document.createElement('div');
      card.className = 'ai-product-card';

      card.innerHTML = `
      <h4>${p.title}</h4>
      <p>₹ ${p.maxPrice}</p>
      <button data-id="${p.id}">Add to Cart</button>
      <button class="rec-btn" data-id="${p.id}">View Product</button>
    `;

      card.addEventListener('click', () => {
        trackEvent('view', p.id);
      });

      card.querySelector('button').addEventListener('click', () => {
        trackEvent('add_to_cart', p.id);
      });

      card.querySelector('.rec-btn').addEventListener('click', () => {
        trackEvent('recommendation_click', p.id);
      });

      grid.appendChild(card);
    });
  }

  document.addEventListener('change', fetchProducts);
  document.addEventListener('DOMContentLoaded', fetchProducts);
</script>

{% schema %}
{
  "name": "AI Product Grid",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Products"
    }
  ]
}
{% endschema %}
