<div class="ai-sorting">
  <label>{{ block.settings.label }}</label>

  <select id="ai-sorting-select"></select>
</div>

<style>
  .ai-sorting {
    margin-bottom: 20px;
  }

  .ai-sorting select {
    padding: 8px;
    width: 100%;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const shop = '{{ shop.domain }}';

    const res = await fetch(`/apps/api/sorting?shop=${shop}`, {
      headers: {
        'ngrok-skip-browser-warning': 'true',
      },
    });
    const sorting = await res.json();

    const select = document.getElementById('ai-sorting-select');

    sorting.forEach((option) => {
      const opt = document.createElement('option');
      opt.value = option.name;
      opt.textContent = option.label;
      select.appendChild(opt);
    });
  });
</script>

{% schema %}
{
  "name": "AI Sorting",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Sorting Label",
      "default": "Sort By"
    }
  ]
}
{% endschema %}
